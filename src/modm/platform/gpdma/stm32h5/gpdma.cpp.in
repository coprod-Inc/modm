#include <modm/architecture/interface/interrupt.hpp>

#include "gpdma.hpp"

%% for instance in instances
%% for channel in range(0, channel_count)
MODM_ISR(GPDMA{{ instance }}_Channel{{ channel }})
{
	modm::platform::Gpdma{{ instance }}::Channel{{ channel }}::interruptHandler();
}

%% endfor
%% endfor
