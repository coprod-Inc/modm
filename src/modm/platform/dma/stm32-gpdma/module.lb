import re
from collections import Counter

def init(module):
    module.name = ":platform:dma"
    module.description = FileReader("module.md")


def prepare(module, options):
    device = options[":target"]
    if device.identifier.family != "h5" or not device.has_driver("gpdma"):
        return False
    # FIXME: The STM32H5E/F GPDMA has 12 channels and more requests. The device data gives both
    # variants the same driver type, so count the channel interrupts instead.
    channels = Counter(m.group(1) for v in device.get_driver("core")["vector"]
                       if (m := re.fullmatch(r"GPDMA(\d)_Channel\d+", v["name"])))
    if set(channels.values()) != {8}:
        return False

    module.depends(
        ":cmsis:device",
        ":platform:gpdma",
        ":platform:rcc")
    return True


def build(env):
    device = env[":target"]
    instances = sorted({int(m.group(1)) for v in device.get_driver("core")["vector"]
                        if (m := re.fullmatch(r"GPDMA(\d)_Channel\d+", v["name"]))})

    env.substitutions = {
        "instances": instances,
        "channel_count": 8,
    }
    env.outbasepath = "modm/src/modm/platform/dma"
    env.copy("dma_base.hpp")
    env.template("dma.hpp.in")
