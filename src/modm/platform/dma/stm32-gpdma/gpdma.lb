def gpdma_channels(device):
    """:returns: a dictionary `map[instance] = number of channels`"""
    channels = defaultdict(int)
    for vector in device.get_driver("core")["vector"]:
        match = re.fullmatch(r"GPDMA(\d)_Channel\d+", vector["name"])
        if match:
            channels[int(match.group(1))] += 1
    return dict(sorted(channels.items()))


def is_supported(device):
    if device.identifier.family != "h5" or not device.has_driver("gpdma"):
        return False
    # FIXME: The STM32H5E/F GPDMA has 12 channels and more requests
    return all("v2" not in d["type"] for d in device.get_all_drivers("gpdma"))


def init(module):
    module.name = ":platform:gpdma"
    module.description = FileReader("gpdma.md")


def prepare(module, options):
    if not is_supported(options[":target"]):
        return False

    module.depends(
        ":architecture:assert",
        ":architecture:interrupt",
        ":architecture:register",
        ":cmsis:device",
        ":platform:rcc")
    return True


def build(env):
    device = env[":target"]
    peripherals = env.query(":cmsis:device:peripherals")
    available = [r for r in requests if r[2] in peripherals]
    signals = sorted({r[3] for r in available if r[3] is not None})

    channels = gpdma_channels(device)
    assert set(channels.values()) == {8}

    env.substitutions = {
        "instances": list(channels),
        "channel_count": 8,
        "requests": available,
        "signals": signals,
    }
    env.outbasepath = "modm/src/modm/platform/gpdma"
    env.template("gpdma_base.hpp.in")
    env.copy("gpdma_hal.hpp")
    env.template("gpdma.hpp.in")
    env.template("gpdma.cpp.in")
