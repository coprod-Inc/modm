def _gpdma_instances(device):
    instances = set()
    for vector in device.get_driver("core")["vector"]:
        name = vector.get("name", "")
        if name.startswith("GPDMA") and "_Channel" in name:
            instances.add(int(name[5]))
    return sorted(instances)


def init(module):
    module.name = ":platform:dma"
    module.description = "Direct Memory Access (DMA)"


def prepare(module, options):
    device = options[":target"]
    if device.identifier.family != "h5":
        return False
    if not device.has_driver("gpdma"):
        return False
    # H5x4/H5x5 use a 12-channel GPDMA (type *v2*); RM0481 8-channel table only.
    if "v2" in device.get_driver("gpdma").get("type", ""):
        return False

    module.depends(
        ":cmsis:device",
        ":platform:rcc",
        ":platform:gpdma")
    return True


def build(env):
    device = env[":target"]
    env.substitutions = {
        "instances": _gpdma_instances(device),
        "channel_count": 8,
    }
    env.outbasepath = "modm/src/modm/platform/dma"
    env.copy("dma_base.hpp")
    env.template("dma.hpp.in", "dma.hpp")
